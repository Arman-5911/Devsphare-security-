# DevSphere Security Environment Configuration

# Fastify API Server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional Database & Background Processing (Production / Docker)
# When omitted, the platform runs in self-contained zero-dependency mode!
DATABASE_URL=postgresql://devsphere:devsphere_secure_password@localhost:5432/devsphere_security
REDIS_URL=redis://localhost:6379
